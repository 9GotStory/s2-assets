{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start:dev": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:http": "vitest run tests/http",
    "test:identity": "node tests/fixtures/identity.ts",
    "test:identity:setup": "node tests/fixtures/identity.ts setup",
    "test:identity:cleanup": "node tests/fixtures/identity.ts cleanup"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/swagger": "9.9.1",
    "@fastify/type-provider-zod": "1.0.0",
    "argon2": "0.45.1",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@types/pg": "8.23.1",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
