# s2-assets database migration one-shot job container (Feature 001, T037).
#
# Authority:
# - specs/001-application-foundation/tasks.md T037
# - Product Owner Stage B authorization & Stage A feasibility report
# - TECHNOLOGY.md §6 & §9 (explicit reviewable migrations before API startup)
#
# Lifecycle & Dependencies:
# - Depends strictly on postgres.service (Requires= and After=).
#   Since postgres.container uses Notify=healthy, this unit activates only after PostgreSQL is ready.
# - Attaches to s2-assets.network to communicate with the database.
# - Executes the approved migration command: node src/migrator.ts latest.
# - Foreground execution under Type=oneshot: exit code from migrator CLI is preserved.
# - Fail-closed: nonzero exit marks unit failed and prevents API startup.
# - Retained state: RemainAfterExit=yes keeps successful state active (exited) as a gate for api.service.
# - Restart=no prevents automatic rerun loops on failure.
# - External inputs: DATABASE_URL provided via api-migration.env or database-url Podman secret.
[Unit]
Description=s2-assets database migration one-shot job
Requires=postgres.service
After=postgres.service

[Container]
Image=localhost/s2-assets-migration:t037
Network=s2-assets.network
Exec=node src/migrator.ts latest
EnvironmentFile=./api-migration.env
Secret=database-url,type=env,target=DATABASE_URL

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=no
