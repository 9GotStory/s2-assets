# s2-assets production API service container (Feature 001, T037).
#
# Authority:
# - specs/001-application-foundation/tasks.md T037
# - Product Owner Stage B authorization & Stage A feasibility report
# - TECHNOLOGY.md §5, §9 (Fastify API, rootless Podman, systemd Quadlet)
#
# Scoped Resource Ownership (R3):
# - ContainerName=s2-assets-api scopes the API container name to this project on the host.
# - Secret=s2-assets-database-url and Secret=s2-assets-cookie-secret scope Podman secrets.
# - Unit Exclusivity: Governed by api.service within this user's systemd session.
#
# Lifecycle Contract & Migration Gate (B2):
# - Requisite=api-migration.service: Strictly asserts that api-migration.service is ALREADY active.
#   If the migration gate has not been run (inactive) or failed, api.service immediately aborts
#   startup without attempting to start or re-run migrations.
# - After=api-migration.service postgres.service ensures proper ordering.
# - Initial Boot: WantedBy=default.target is deliberately OMITTED.
#   Initial boot leaves api-migration inactive; automatic boot of api.service would mislead and fail.
#   Instead, operator/deployment orchestration executes the explicit startup sequence:
#     1. systemctl --user start postgres.service (waits for TCP healthcheck / Notify=healthy)
#     2. systemctl --user start api-migration.service (ExecStartPre verifies postgres; blocks for exit 0)
#     3. systemctl --user start api.service
# - API Restart: 'systemctl --user restart api.service' checks Requisite=, sees api-migration.service
#   still in active (exited) state, and starts API directly WITHOUT triggering migrations.
# - PostgreSQL Recovery: If postgres restarts, Wants= on api-migration preserves the gate state;
#   API reconnects when postgres is healthy without re-running migrations.
# - Controlled Rollout Protocol:
#   Every release pairs an immutable API image with its matching migration image from the same commit.
#   Prohibited: Updating API Image= while retaining an old release's successful migration gate.
#   Rollout steps:
#     1. Invalidate old gate: 'systemctl --user stop api-migration.service'
#     2. Update Image= in api-migration.container and api.container
#     3. 'systemctl --user daemon-reload'
#     4. 'systemctl --user start api-migration.service' (blocks until new migration succeeds)
#        If failed: API remains blocked by Requisite=. Operator investigates and retries.
#     5. 'systemctl --user restart api.service' (starts new API container)
# - Network & Exposure: Attaches to s2-assets.network; publishes loopback-only 127.0.0.1:3000:3000.
[Unit]
Description=s2-assets API service
Requisite=api-migration.service
After=api-migration.service postgres.service

[Container]
ContainerName=s2-assets-api
Image=localhost/s2-assets-api:t036
Network=s2-assets.network
PublishPort=127.0.0.1:3000:3000
EnvironmentFile=./api.env
Secret=s2-assets-database-url,type=env,target=DATABASE_URL
Secret=s2-assets-cookie-secret,type=env,target=COOKIE_SECRET

[Service]
Restart=always
RestartSec=5s
