# s2-assets PostgreSQL database container (Feature 001, T037).
#
# Authority:
# - specs/001-application-foundation/tasks.md T037
# - TECHNOLOGY.md §6, §9 (PostgreSQL 18.6-alpine, private DB network, no public port)
# - Feature 001 plan.md & research.md
#
# Scoped Resource Ownership (R3):
# - ContainerName=s2-assets-postgres scopes the container name to this project on the host.
# - NetworkAlias=postgres preserves internal DNS resolution for 'postgres:5432' within s2-assets.network.
# - Volume=postgres-data.volume:/var/lib/postgresql mounts s2-assets-postgres-data at the storage root.
# - Secret=s2-assets-postgres-password scopes the database credential Podman secret.
# - Unit Exclusivity: Governed by postgres.service within this user's systemd session.
#
# TCP Readiness vs Temporary Init Server Race Prevention (R2):
# - Official postgres entrypoint (docker-entrypoint.sh:50-65) starts a temporary socket-only server
#   with '-c listen_addresses=""' during fresh cluster initialization before stopping and starting
#   the final external TCP server.
# - Using pg_isready with explicit TCP host (-h 127.0.0.1 -p 5432) ensures the healthcheck
#   CANNOT pass against the temporary socket-only server (which refuses TCP), preventing
#   Notify=healthy from prematurely transitioning postgres.service to 'active' before TCP is operational.
#   This active transition is verified at startup by api-migration.service's ExecStartPre prerequisite.
# - Note: pg_isready tests connection acceptance only; it does not authenticate credentials or validate schema.
#
# Lifecycle & Recovery (B2):
# - Systemd user service lifecycle: Restart=always with RestartSec=5s ensures crash recovery.
# - Enabled at default.target so database starts automatically on boot/user session start.
[Unit]
Description=s2-assets PostgreSQL database
Wants=s2-assets-network.service postgres-data-volume.service
After=s2-assets-network.service postgres-data-volume.service

[Container]
ContainerName=s2-assets-postgres
Image=docker.io/library/postgres:18.6-alpine
Network=s2-assets.network
NetworkAlias=postgres
Volume=postgres-data.volume:/var/lib/postgresql
EnvironmentFile=./postgres.env
Secret=s2-assets-postgres-password
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/s2-assets-postgres-password
Notify=healthy
HealthCmd=pg_isready -h 127.0.0.1 -p 5432 -U "$POSTGRES_USER" -d "$POSTGRES_DB"
HealthInterval=5s
HealthTimeout=3s
HealthRetries=5
HealthStartPeriod=10s

[Service]
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
