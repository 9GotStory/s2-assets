# s2-assets PostgreSQL database container (Feature 001, T037).
#
# Authority:
# - specs/001-application-foundation/tasks.md T037
# - TECHNOLOGY.md §6, §9 (PostgreSQL 18.6-alpine, private DB network, no public port)
# - Feature 001 plan.md & research.md
#
# Lifecycle & Readiness:
# - Attaches exclusively to the private internal network defined by s2-assets.network.
# - No host port is published in any form (no PublishPort or ExposeHostPort).
# - Mounts the persistent volume at /var/lib/postgresql (PostgreSQL 18 storage parent).
# - Native readiness check using pg_isready against local instance.
# - Notify=healthy postpones systemd readiness until PostgreSQL is healthy and accepting connections.
# - Systemd user service manages restart lifecycle (Restart=always).
# - External inputs: non-secret identity via postgres.env; secret password via postgres-password Podman secret.
[Unit]
Description=s2-assets PostgreSQL database

[Container]
Image=docker.io/library/postgres:18.6-alpine
Network=s2-assets.network
NetworkAlias=postgres
ContainerName=postgres
Volume=postgres-data.volume:/var/lib/postgresql
EnvironmentFile=./postgres.env
Secret=postgres-password
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password
Notify=healthy
HealthCmd=pg_isready -q
HealthInterval=5s
HealthTimeout=3s
HealthRetries=5
HealthStartPeriod=10s

[Service]
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
